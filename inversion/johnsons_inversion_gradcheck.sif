!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!  Johnsons basal sliding inversion      !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

$yearinsec = 365.25*60*60*24
$rhoi = 900.0/(1.0e6*yearinsec^2)   
$gravity = -9.81*yearinsec^2

! Rate factor from Cuffey and Paterson (2010), MPa^-3 a^-1
$A1 = 2.89165e-13*yearinsec*1.0e18
$A2 = 2.42736e-02*yearinsec*1.0e18
$Q1 = 60.0e3
$Q2 = 115.0e3

$niter = 20   ! gradient validation: 1 adjoint eval + 19 finite-difference steps (h halving each time)
$Lambda = 1.0e4   ! same Lambda as the interval-narrowing (bisection) step being checked

Header
  Mesh DB "mesh/front_refined" "mesh_Johnson_gmsh_2D_100_front_refined"   ! finer front resolution
  Results Directory "./results/"
End

Simulation
  Coordinate System = Cartesian 2D  
  Simulation Type = Steady State

  Extruded Mesh Levels = Integer 5   ! was 10 - halved temporarily to speed up debugging

  Steady State Min Iterations = 1
  Steady State Max Iterations = Integer $niter  

  Output File = "johnsons_inv_01.result"
  Post File = "johnsons_inv_01.vtu"
  Output Coordinates = Logical True

  max output level = 5
End

Body Force 1
  Flow BodyForce 1 = Real 0.0
  Flow BodyForce 2 = Real 0.0
  Flow BodyForce 3 = Real $gravity
End

Material 1
  Density = Real $rhoi

  Viscosity Model = String "glen"
  Viscosity = 1.0   ! dummy but avoid a warning output
  Glen Exponent = Real 3.0

  Limit Temperature = Real -10.0
  Rate Factor 1 = Real $A1
  Rate Factor 2 = Real $A2
  Activation Energy 1 = Real $Q1
  Activation Energy 2 = Real $Q2
  Glen Enhancement Factor = Real 1.0
  Critical Shear Rate = Real 1.0e-10

  Constant Temperature = Real -1.0   ! same as JM, not Johnsons-specific

  Cauchy = Logical True
End

Solver 1
  Exec Solver = "Before Simulation"
  Equation = "Read DEM"
  Procedure = "ElmerIceSolvers" "Grid2DInterpolator"

  Variable 1 = String "Zb"
  Variable 1 data file = File "mesh/DEM_Johnsons_bed.dat"
  Variable 1 x0 = Real 634122.00
  Variable 1 y0 = Real 3046767.00
  Variable 1 lx = Real 2760.0
  Variable 1 ly = Real 2960.0
  Variable 1 Nx = Integer 70
  Variable 1 Ny = Integer 75
  Variable 1 Invert = Logical False
  Variable 1 Fill = Logical False
  Variable 1 Position Tol = Real 1.0e1
  Variable 1 No Data = Real -9999.0
  Variable 1 No Data Tol = Real 1.0

  Variable 2 = String "Zs"
  Variable 2 data file = File "mesh/DEM_Johnsons_surf.dat"
  Variable 2 x0 = Real 634122.00
  Variable 2 y0 = Real 3046767.00
  Variable 2 lx = Real 2760.0
  Variable 2 ly = Real 2960.0
  Variable 2 Nx = Integer 70
  Variable 2 Ny = Integer 75
  Variable 2 Invert = Logical False
  Variable 2 Fill = Logical False
  Variable 2 Position Tol = Real 1.0e1
  Variable 2 No Data = Real -9999.0
  Variable 2 No Data Tol = Real 1.0
End

Solver 2
  Exec Solver = "Before Simulation"
  Equation = "ScatteredInterVx"
  Procedure = "Scattered2DDataInterpolator" "Scattered2DDataInterpolator"

  Variable 1 = String "Vsx"
  Variable 1 method = String "c"
  Variable 1 data file = File "../kriging/output/Johnsons_vx_kriged_smooth.dat"   ! 3-year smoothed (2006-2009, 18 stakes)
  CheckNaN = Logical True
  Replace NaN by = Real 0.0
End

Solver 3
  Exec Solver = "Before Simulation"
  Equation = "ScatteredInterVy"
  Procedure = "Scattered2DDataInterpolator" "Scattered2DDataInterpolator"

  Variable 1 = String "Vsy"
  Variable 1 method = String "c"
  Variable 1 data file = File "../kriging/output/Johnsons_vy_kriged_smooth.dat"   ! 3-year smoothed (2006-2009, 18 stakes)
  CheckNaN = Logical True
  Replace NaN by = Real 0.0
End

Solver 4
  Equation = "MapCoordinate"
  Procedure = "StructuredMeshMapper" "StructuredMeshMapper"
  Active Coordinate = Integer 3
  Displacement Mode = Logical False
  Correct Surface = Logical True
  Minimum Height = Real 1.0
End

Solver 5
  Equation = "Navier-Stokes"
  Stabilization Method = String Stabilized
  Flow Model = Stokes

  Exported Variable 1 = -global CostValue
  Exported Variable 2 = -nooutput "Velocityb"
  Exported Variable 2 DOFs = 4
  Exported Variable 3 = "Vsx"
  Exported Variable 4 = "Vsy"

  Linear System Solver = Iterative
  Linear System Iterative Method = BICGStab
  Linear System Preconditioning = ILU0
  Linear System Convergence Tolerance = Real 1.0e-12
  Linear System Max Iterations = 50000
  Linear System Residual Output = 500
  Linear System Abort Not Converged = True

  Nonlinear System Max Iterations = 50   ! matches StokesWeertman example (JM: 100) 
  Nonlinear System Convergence Tolerance = 1.0e-08   ! was 2.0e-04 - loose tolerance was letting under-converged solves through to the cost function
  Nonlinear System Newton After Iterations = 5   ! was 40 (JM)
  Nonlinear System Newton After Tolerance = 1.0e-04
  Nonlinear System Relaxation Factor = 1.00

  Steady State Convergence Tolerance = Real 1.0e-12
End

Solver 6
  Exec Solver = "Before Simulation"
  Equation = "Normal vector"
  Variable = "Normal Vector"
  Variable DOFs = 3
  Optimize Bandwidth = Logical False
  Procedure = "ElmerIceSolvers" "ComputeNormalSolver"
  ComputeAll = Logical False
End

Body 1
  Equation = 1
  Body Force = 1
  Material = 1
  Initial Condition = 1
End

Initial Condition 1
  Pressure = Real 0.0
  Velocity 1 = Real 0.0
  Velocity 2 = Real 0.0
  Velocity 3 = Real 0.0
  Vsx = Equals Velocity 1
  Vsy = Equals Velocity 2
End

! Body 2 = top surface (cost function), Body 3 = bed (optimized variable).
! Not real mesh regions - created via Body Id on the surface/bed BCs, step 7.
Body 2
  Equation = 2
  Initial Condition = 2
  Body Force = 2
End

Body 3
  Equation = 3
  Initial Condition = 3
End

Initial Condition 2
  Zs = Equals Zs
End

Initial Condition 3
  alpha = Real -1.35   ! log10(0.045) - alpha is  log10(C), like in StokesWeertman example
  Zb = Equals Zb
End

! local mismatch 0.5*(u-uobs)^2 + 0.5*(v-vobs)^2, integrated over Body 2 by Solver 7
Body Force 2
  Adjoint Cost = Variable Velocity 1, Vsx, Velocity 2, Vsy
    Real MATC "0.5*(tx[0]-tx[1])*(tx[0]-tx[1])+0.5*(tx[2]-tx[3])*(tx[2]-tx[3])"

  Adjoint Cost der 1 = Variable Velocity 1, Vsx
    Real MATC "(tx[0]-tx[1])"

  Adjoint Cost der 2 = Variable Velocity 2, Vsy
    Real MATC "(tx[0]-tx[1])"
End

Solver 7
  Equation = "Cost"
  Procedure = "ElmerIceSolvers" "Adjoint_CostContSolver"

  Cost Variable Name = String "CostValue"
  Cost Filename = File "Cost_steady.dat"
  Sensitivity Variable Name = String "velocityb"

  Exported Variable 1 = Zs
End

Solver 8
  Equation = "Adjoint"
  Variable = -nooutput Adjoint
  Variable Dofs = 4
  Procedure = "ElmerIceSolvers" "Adjoint_LinearSolver"

  Direct Solver Equation Name = String "Navier-Stokes"

  Linear System Solver = Iterative
  Linear System Iterative Method = GCR
  Linear System Preconditioning = ILU1
  Linear System Convergence Tolerance = 1.0e-9
  Linear System Max Iterations = 5000
End

Solver 9
  Equation = "DJDBeta"
  Procedure = "ElmerIceSolvers" "AdjointStokes_GradientBetaSolver"

  Flow Solution Name = String "Flow Solution"
  Adjoint Solution Name = String "Adjoint"
  Gradient Variable Name = String "DJDalpha"

  Exported Variable 1 = alpha
  Exported Variable 2 = DJDalpha
  Exported Variable 3 = Zb
  Exported Variable 4 = BetaS
End

Solver 10
  Equation = "DJDBeta_Reg"
  Procedure = "ElmerIceSolvers" "Adjoint_CostRegSolver"

  Cost Filename = File "CostReg_steady.dat"
  Optimized Variable Name = String "alpha"
  Gradient Variable Name = String "DJDalpha"
  Cost Variable Name = String "CostValue"
  Lambda = Real $Lambda
  Reset Cost Value = Logical False
  A priori Regularisation = Logical False
End

Solver 11
  Equation = "GradientValidation"
  Procedure = "ElmerIceSolvers" "Adjoint_GradientValidation"

  Cost Variable Name = String "CostValue"
  Optimized Variable Name = String "alpha"
  Gradient Variable Name = String "DJDalpha"
  Result File = File "Validation.dat"
End

Equation 1
  Active Solvers(7) = 1 2 3 4 5 6 8
End

! Top surface: cost function only
Equation 2
  Active Solvers(1) = 7
End

! Bed: gradient, regularisation, optimizer
Equation 3
  Active Solvers(3) = 9 10 11
End

! Lateral rock margin ("roca", 90 elements in the mesh)
Boundary Condition 1
  Target Boundaries = 1
  Flow Force BC = Logical True
  Velocity 1 = Real 0.0
  Velocity 2 = Real 0.0
End

! Ice divide ("div", 57 elements)
Boundary Condition 2
  Target Boundaries = 2
  Velocity 1 = Real 0.0
  Velocity 2 = Real 0.0
End

! Front ("front", 8 elements) - marine-terminating 
Boundary Condition 3
  Target Boundaries = 3
  External Pressure = Variable Coordinate 3
    Real Procedure "ElmerIceUSF" "SeaPressure"
  Compute Sea Pressure = Logical True
End

! Bed (added by extrusion)
Boundary Condition 4
  Name = "bottom"
  Target Boundaries = 4
  Body Id = 3
  Bottom Surface = Equals Zb

  ComputeNormal = Logical True
  Flow Force BC = Logical True
  Normal-Tangential Velocity = Logical True
  Velocity 1 = Real 0.0e0

  Slip Coefficient 2 = Variable Coordinate 1
    Real Procedure "ElmerIceUSF" "Sliding_Weertman"
  Slip Coefficient 3 = Variable Coordinate 1
    Real Procedure "ElmerIceUSF" "Sliding_Weertman"

  ! C = 10^alpha (StokesWeertman example) - stays positive at any step
  Weertman Friction Coefficient = Variable alpha
    Real Procedure "ElmerIceUSF" "TenPowerA"
  Weertman Exponent = Real $1.0/3.0
  Weertman Linear Velocity = Real 0.1

  Slip Coefficient derivative = Variable alpha
    Real Procedure "ElmerIceUSF" "TenPowerA_d"
End

! Surface (added by extrusion)
Boundary Condition 5
  Target Boundaries = 5
  Body Id = 2
  Top Surface = Equals Zs
End

